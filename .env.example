TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
# Preferred: many free AI Studio projects (one key each). On 429/daily free-tier
# the app cools that key and rotates to the next automatically.
# GEMINI_API_KEYS=key_project1,key_project2,key_project3,key_project4,key_project5
PINECONE_API_KEY=your_pinecone_api_key
# Comma-separated Telegram user IDs allowed to ingest PDFs
ADMIN_USER_IDS=123456789
# Optional: set by Render/hosting
# PORT=8080
#
# Webhook secret (X-Telegram-Bot-Api-Secret-Token). Overrides config.yaml.
# WEBHOOK_SECRET_TOKEN=long-random-string
#
# Render.com Deploy Console integration
# RENDER_API_KEY=rnd_...
# RENDER_SERVICE_ID=srv-...
#
# If hosting the Deploy Console on Render (Web Service):
# CONSOLE_PASSWORD=strong-password-here
# CONSOLE_USER=admin
# CONSOLE_NO_BROWSER=1
# CONSOLE_HOST=0.0.0.0
#
# Bot ↔ Console link (same token on BOTH Render services)
# INTERNAL_SERVICE_TOKEN=long-random-string
# BOT_BASE_URL=https://your-bot.onrender.com
# CONSOLE_BASE_URL=https://your-console.onrender.com
#
# After deploy: re-ingest PDFs into library-index-v2 (Gemini embeddings 768-d).
# Old library-index (e5 1024-d) is not used by default anymore.
