TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
# Optional: comma-separated rotation pool
# GEMINI_API_KEYS=key1,key2
PINECONE_API_KEY=your_pinecone_api_key
# Comma-separated Telegram user IDs allowed to ingest PDFs
ADMIN_USER_IDS=123456789
# Optional: set by Render/hosting
# PORT=8080
#
# After deploy: re-ingest PDFs into library-index-v2 (Gemini embeddings 768-d).
# Old library-index (e5 1024-d) is not used by default anymore.
